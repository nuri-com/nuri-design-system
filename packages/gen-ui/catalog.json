{
  "name": "nuri-gen-ui-catalog",
  "version": "0.2.0",
  "components": [
    {
      "name": "Headline",
      "description": "Section or screen title.",
      "props": {
        "text": { "type": "string", "required": true },
        "level": { "type": "'h1' | 'h2' | 'h3'", "required": false, "default": "'h2'" }
      }
    },
    {
      "name": "Paragraph",
      "description": "Body text block.",
      "props": {
        "text": { "type": "string", "required": true },
        "muted": { "type": "boolean", "required": false, "default": "false" }
      }
    },
    {
      "name": "Button",
      "description": "Command action. Never use text or icons as bare clickables.",
      "props": {
        "label": { "type": "string", "required": true },
        "variant": { "type": "'primary' | 'secondary' | 'destructive'", "required": false, "default": "'primary'" },
        "disabled": { "type": "boolean", "required": false, "default": "false" },
        "loading": { "type": "boolean", "required": false, "default": "false" },
        "onPress": { "type": "() => void", "required": true }
      }
    },
    {
      "name": "InputField",
      "description": "Single-line text input with label and error state.",
      "props": {
        "label": { "type": "string", "required": false },
        "value": { "type": "string", "required": true },
        "placeholder": { "type": "string", "required": false },
        "error": { "type": "string", "required": false },
        "keyboardType": { "type": "'default' | 'email-address' | 'numeric'", "required": false, "default": "'default'" },
        "onChangeText": { "type": "(text: string) => void", "required": true }
      }
    },
    {
      "name": "Dropdown",
      "description": "Single-choice selector from a fixed option list.",
      "props": {
        "label": { "type": "string", "required": false },
        "options": { "type": "Array<{ value: string; label: string }>", "required": true },
        "value": { "type": "string", "required": true },
        "onChange": { "type": "(value: string) => void", "required": true },
        "disabled": { "type": "boolean", "required": false, "default": "false" }
      }
    },
    {
      "name": "List",
      "description": "Vertical list of labelled rows.",
      "props": {
        "items": { "type": "Array<{ id: string; label: string; detail?: string }>", "required": true },
        "onPressItem": { "type": "(id: string) => void", "required": false }
      }
    },
    {
      "name": "Card",
      "description": "Content container surface.",
      "props": {
        "children": { "type": "ReactNode", "required": true },
        "padding": { "type": "keyof space", "required": false, "default": "'md'" }
      }
    },
    {
      "name": "Switch",
      "description": "Binary on/off toggle.",
      "props": {
        "label": { "type": "string", "required": false },
        "value": { "type": "boolean", "required": true },
        "onChange": { "type": "(value: boolean) => void", "required": true },
        "disabled": { "type": "boolean", "required": false, "default": "false" }
      }
    },
    {
      "name": "AmountInput",
      "description": "Currency amount input with fiat/crypto display.",
      "props": {
        "value": { "type": "string", "required": true },
        "currency": { "type": "'BTC' | 'EUR' | 'USD'", "required": true },
        "onChange": { "type": "(amount: string) => void", "required": true },
        "autoFocus": { "type": "boolean", "required": false, "default": "false" }
      }
    },
    {
      "name": "Spinner",
      "description": "Indeterminate loading indicator.",
      "props": {
        "size": { "type": "'sm' | 'md' | 'lg'", "required": false, "default": "'md'" },
        "label": { "type": "string", "required": false }
      }
    }
  ]
}
